# API Keys — copy to .env and fill in
ANTHROPIC_API_KEY=your_key_here
RUNWARE_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here
ELEVENLABS_API_KEY=your_key_here

# Set to "openrouter" to route the multi-model feedback loop through OpenRouter
# instead of Runware. Stage 1/2 council calls switch per-stage via
# config/stage.yaml's llm.provider field instead.
LLM_PROVIDER=runware
